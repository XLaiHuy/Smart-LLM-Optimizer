# Copy to .env at repository root. Never commit .env or API keys.
APP_ENV=development
DATABASE_PATH=data/smartllm.db
PROVIDER_MODE=mock
# Explicit operator gate; keep false until reviewed catalog + pilot budget approval.
RESEARCH_LIVE_ENABLED=false
# ML remains experimental until independent evaluation and operator review.
AUTO_ROUTING_STRATEGY=rule_guarded
ML_ROUTER_ARTIFACT_PATH=config/router_model.json
ML_ROUTER_LIVE_APPROVED=false
ML_ROUTER_QUALIFICATION_PATH=config/router_live_qualified.review.json
ML_ROUTER_ALLOW_RESEARCH_CANDIDATE=false
# Development chat requires a separate, artifact-bound operator acceptance.
ML_ROUTER_RESEARCH_ACCEPTANCE_PATH=config/router_research_acceptance.json
# Shared persistent quotas: confirm your organization's current account limits.
PROVIDER_QUOTA_ENABLED=true
PROVIDER_QUOTA_ACCOUNT=default-organization
GROQ_QUOTA_RPM=24
GROQ_QUOTA_RPD=800
GROQ_QUOTA_TPM=6400
GROQ_QUOTA_TPD=160000
OPENROUTER_FREE_RPM=16
# Set 800 only after GET /api/v1/key confirms a 1000/day ceiling.
OPENROUTER_FREE_RPD=40
# Application pacing for paid profiles; provider headers may tighten it.
OPENROUTER_PAID_RPM=16
OPENAI_QUOTA_RPM=24
PROVIDER_MAX_FAILOVERS=2
ROUTER_TRAINING_MANIFEST_PATH=data/router-training/manifest.json
# Reviewed gold-label pilot preparation/resume: docs/ROUTER_GOLD_PILOT.md.
# After preparation/review, select data/router-pilot-v1/manifest.json instead.
ROUTER_TRAINING_DIRECTORY=data/router-training
# Read-only tool execution is demonstrated in mock; live needs separate review.
TOOLS_LIVE_APPROVED=false
# Admin estimates only. Requires a separately reviewed paired live benchmark report.
BENCHMARK_IMPACT_APPROVED=false
BENCHMARK_IMPACT_PATH=config/benchmark-impact.json
MOCK_CONFIG_ID=mock-baseline
AUTH_SESSION_HOURS=8
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000"]
PROJECT_BUDGET_USD=20.00
DEFAULT_USER_BUDGET_USD=5.00
LOG_LEVEL=INFO
# Live requires a reviewed model catalog; mock never calls paid APIs.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional three-model template: config/models.openai.example.json.
# Copy to config/models.json only after review; verification flags start false.
MODEL_CATALOG_PATH=config/models.json
UPLOAD_DIRECTORY=data/uploads
MAX_FILE_BYTES=10485760
MAX_DOCUMENTS=5
MAX_DOCUMENT_CHARS=200000
MAX_PDF_PAGES=200
PARSER_TIMEOUT_SECONDS=30
DOCUMENT_OPERATION_BUDGET_USD=1.00
ADAPTIVE_PROMPT_ENABLED=false
HYBRID_CONTEXT_ENABLED=false
MEMORY_RETRIEVAL_ENABLED=false
CONTEXT_TOKEN_BUDGET=8000
