# Copy to .env at repository root. Never commit .env or API keys.
APP_ENV=development
DATABASE_PATH=data/smartllm.db
PROVIDER_MODE=mock
MOCK_CONFIG_ID=mock-baseline
AUTH_SESSION_HOURS=8
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000"]
PROJECT_BUDGET_USD=20.00
DEFAULT_USER_BUDGET_USD=5.00
LOG_LEVEL=INFO
# Reserved for G2. G0 refuses live mode even when a key is set.
OPENAI_API_KEY=
OPENAI_MODEL=
